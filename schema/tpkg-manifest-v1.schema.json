{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tebako.org/schemas/tpkg-manifest-v1.schema.json",
  "title": "tpkg payload manifest v1",
  "description": "The in-image payload manifest at /__tpkg__/manifest.yaml (spec 03): IDENTITY + PROVIDES + DEPENDS on a common provenance/trust layer. This schema is the STRUCTURAL contract; the tpkg crate's PayloadManifest::validate() is the semantic gate (capability truth tables, digest shapes, the constraint grammar — constraints are only length-checked here). Unknown keys are tolerated at every level for forward compatibility; only identity.annotations is guaranteed lossless.",
  "type": "object",
  "required": ["identity", "provides"],
  "properties": {
    "identity": { "$ref": "#/$defs/identity" },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "materialize": {
      "type": "array",
      "items": { "$ref": "#/$defs/absPath" },
      "description": "spec 22 §4 class R (payload-manifest schema_minor 1): absolute in-image paths of regular files the driver materializes to <TEBAKO_EXEC_CACHE>/resources/<image-key>/<P> after the mounts, before the interpreter handoff — whole-file, read-only, digest-verified. Any kind may declare; old readers ignore the key. The '..' refusal is semantic (the tpkg validator); only the absolute shape is checked here."
    },
    "library_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/absPath" }
        }
      },
      "description": "spec 22 §2.1 windows Class L bare-name rule (payload-manifest schema_minor 2): the ONLY bare library names resolving to the image's own files — a bare name matching no entry is a host reference and passes through untouched. `name` is the exact bare spelling a loader call presents (the no-separator/no-drive refusal is semantic, the tpkg validator); `path` is the absolute in-image file it resolves to. Any kind may declare; old readers ignore the key."
    },
    "checks": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/$defs/check" },
      "description": "spec 26 §1 (payload-manifest schema_minor 3): the payload's own acceptance contracts — check name → check. A check WITH `entry` is an exec check; WITHOUT `entry` it is structural (the data-slice shape: asserts expect.image_files, no exec surface). The reserved entry spelling \"self\" is kind-runtime only, the exec/structural key split, the '..' refusals and the {scratch} arity are semantic (the tpkg validator); only shape is checked here. Any kind may declare; old readers ignore the key."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "identity": { "properties": { "kind": { "const": "app" } }, "required": ["kind"] } }, "required": ["identity"] },
      "then": { "properties": { "provides": { "$ref": "#/$defs/appProvides" } } }
    },
    {
      "if": { "properties": { "identity": { "properties": { "kind": { "const": "runtime" } }, "required": ["kind"] } }, "required": ["identity"] },
      "then": { "properties": { "provides": { "$ref": "#/$defs/runtimeProvides" } } }
    },
    {
      "if": { "properties": { "identity": { "properties": { "kind": { "const": "data" } }, "required": ["kind"] } }, "required": ["identity"] },
      "then": { "properties": { "provides": { "$ref": "#/$defs/dataProvides" } } }
    },
    {
      "if": { "properties": { "identity": { "properties": { "kind": { "enum": ["toolkit", "language"] } }, "required": ["kind"] } }, "required": ["identity"] },
      "then": { "properties": { "provides": { "type": "object" } } }
    }
  ],
  "$defs": {
    "sha256hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "treeHash": {
      "type": "string",
      "pattern": "^[a-z0-9]+:[0-9a-f]{64}$",
      "description": "\"<algorithm>:<64 lowercase hex>\" — the key does not name an algorithm, so the value self-describes (the plaintext merkle root: semantic identity, CAS)."
    },
    "keyid": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "The low 64 bits of the signer's OpenPGP fingerprint, lowercase hex."
    },
    "absPath": {
      "type": "string",
      "pattern": "^/"
    },
    "check": {
      "type": "object",
      "description": "One acceptance check (spec 26 §1). Absent `entry` makes the check STRUCTURAL by grammar (MECE — never a kind flag). Byte-golden assertions do not exist by construction: expect carries existence+non-empty channels only.",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "The in-image absolute executable path, or the reserved spelling \"self\" (kind runtime only — semantic). Exec checks only."
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Exec-only. `{scratch}` (the per-run host scratch dir) at most once per entry — semantic; every other spelling is literal passthrough."
        },
        "fixtures": {
          "$ref": "#/$defs/absPath",
          "description": "Exec-only. The in-image dir whose CONTENTS land at the host scratch root (never VFS-spelled)."
        },
        "expect": {
          "type": "object",
          "properties": {
            "exit": { "type": "integer", "minimum": 0, "description": "Expected exit status; absent = 0." },
            "files": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
              "description": "Scratch-relative paths asserted to exist and be non-empty; the '..' refusal is semantic (the tpkg validator)."
            },
            "stdout": { "type": "string", "minLength": 1, "description": "One regex the run's stdout must match; the engine compiles it." },
            "image_files": {
              "type": "array",
              "items": { "$ref": "#/$defs/absPath" },
              "description": "In-image paths asserted to exist and be non-empty — the structural check's assertion channel."
            }
          }
        },
        "needs": {
          "type": "array",
          "description": "Additive host needs for the check run ONLY (a minimal mirror of the spec 23 §2 entry grammar).",
          "items": {
            "type": "object",
            "required": ["path", "access"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "access": { "enum": ["ro", "rw"] },
              "when": { "type": "array", "items": { "enum": ["windows", "macos", "linux"] } },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        },
        "requires": {
          "type": "object",
          "required": ["provides"],
          "description": "Composition prerequisites; unmet ⇒ SKIP, never FAIL (spec 26 §2).",
          "properties": {
            "provides": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "when": {
          "type": "array",
          "items": { "enum": ["windows", "macos", "linux"] },
          "description": "The OS-family platform filter (NOT the spec 03 §3 triplet axis); absent = every platform."
        },
        "timeout": { "type": "integer", "minimum": 1, "description": "Seconds; expiry is a FAIL." }
      }
    },
    "constraint": {
      "type": "string",
      "minLength": 1,
      "description": "Version constraint in the spec-03 grammar (cargo-style ranges AND ruby-style abi lines AND datever): clause (\",\" clause)*; clause := (\">=\"|\"<=\"|\"~>\"|\">\"|\"<\"|\"!=\"|\"=\")? version; version := 1..=4 dot-separated decimals. Enforced by the tpkg crate; only presence/shape is checked here."
    },
    "platformTriplet": {
      "type": "string",
      "enum": [
        "aarch64-macos",
        "x86_64-macos",
        "x86_64-linux-gnu",
        "aarch64-linux-gnu",
        "x86_64-linux-musl",
        "aarch64-linux-musl",
        "x86_64-windows-ucrt"
      ],
      "description": "The locked vcpkg-triplet axis (spec 03 §3). aarch64-windows-ucrt is RESERVED and excluded on purpose."
    },
    "platformList": {
      "type": "array",
      "items": { "$ref": "#/$defs/platformTriplet" },
      "minItems": 1,
      "uniqueItems": true
    },
    "platformsAxis": {
      "description": "`platforms` is EITHER \"universal\" OR an explicit triplet list (spec 03 §3).",
      "anyOf": [
        { "const": "universal" },
        { "$ref": "#/$defs/platformList" }
      ]
    },
    "identity": {
      "type": "object",
      "required": ["schema_version", "kind", "name", "version", "producer", "created", "digest", "signing", "encryption"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "enum": ["app", "data", "toolkit", "runtime", "language"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "description": "Free-form version string (semver AND datever payloads exist)." },
        "producer": {
          "type": "object",
          "required": ["tool", "tool_version"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "tool_version": { "type": "string", "minLength": 1 }
          }
        },
        "created": { "type": "string", "minLength": 1, "description": "Creation timestamp (RFC 3339 rendering)." },
        "source": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "src_sha256": { "$ref": "#/$defs/sha256hex" },
            "commit": { "type": "string", "minLength": 1 },
            "builder": { "type": "string", "minLength": 1 }
          }
        },
        "sbom": {
          "type": "object",
          "required": ["ref"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "digest": {
          "type": "object",
          "required": ["tree_hash", "blob_sha256"],
          "properties": {
            "tree_hash": { "$ref": "#/$defs/treeHash" },
            "blob_sha256": { "$ref": "#/$defs/sha256hex" }
          }
        },
        "signing": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["unsigned", "signed"] },
            "keyid": { "$ref": "#/$defs/keyid" },
            "mechanism": { "const": "openpgp" }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "signed" } }, "required": ["state"] },
              "then": { "required": ["keyid", "mechanism"] }
            },
            {
              "if": { "properties": { "state": { "const": "unsigned" } }, "required": ["state"] },
              "then": { "not": { "anyOf": [{ "required": ["keyid"] }, { "required": ["mechanism"] }] } }
            }
          ]
        },
        "encryption": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["none", "encrypted"] },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["paths", "algorithm", "envelope_refs"],
                "properties": {
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/absPath" }
                  },
                  "algorithm": { "type": "string", "minLength": 1 },
                  "envelope_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 },
                    "description": "References to the externally-held grant envelopes (spec 10) — NEVER keys."
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "encrypted" } }, "required": ["state"] },
              "then": { "required": ["parts"], "properties": { "parts": { "minItems": 1 } } }
            },
            {
              "if": { "properties": { "state": { "const": "none" } }, "required": ["state"] },
              "then": { "properties": { "parts": { "maxItems": 0 } } }
            }
          ]
        },
        "annotations": {
          "type": "object",
          "description": "Free-form k/v; unknown keys preserved on round-trip."
        }
      }
    },
    "capabilitiesApp": {
      "type": "object",
      "required": ["exec", "read"],
      "properties": {
        "exec": { "const": true },
        "read": { "const": true },
        "host": { "$ref": "#/$defs/hostJail" }
      },
      "not": { "required": ["runtime"] }
    },
    "capabilitiesRuntime": {
      "type": "object",
      "required": ["exec", "read", "runtime"],
      "properties": {
        "exec": { "const": true },
        "read": { "const": true },
        "runtime": { "const": true },
        "host": { "$ref": "#/$defs/hostJail" }
      }
    },
    "capabilitiesData": {
      "type": "object",
      "required": ["exec", "read"],
      "properties": {
        "exec": { "const": false },
        "read": { "const": true },
        "host": { "$ref": "#/$defs/hostJail" }
      },
      "not": { "required": ["runtime"] }
    },
    "hostJail": {
      "type": "object",
      "description": "capabilities.host (spec 08 §4): the host access the payload was BUILT TO NEED — a REQUEST the dispatch surfaces compose with the user's tightening (manifest request ∩ user policy = effective jail, spec 08 §2). Absent = open (today's behavior).",
      "properties": {
        "default": { "enum": ["open", "deny"] },
        "mounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostJailMount" }
        },
        "argument_files": {
          "description": "EITHER the scalar \"auto-allowed\" (dispatch resolves argv files into read-only grants) OR an explicit path list (read-only grants, honored even under deny).",
          "anyOf": [
            { "const": "auto-allowed" },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "hostJailMount": {
      "type": "object",
      "required": ["host", "mount", "access"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "mount": { "$ref": "#/$defs/absPath" },
        "access": { "enum": ["ro", "rw"] }
      }
    },
    "runtimeRequirement": {
      "type": "object",
      "required": ["engine", "constraint"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "constraint": { "$ref": "#/$defs/constraint" }
      }
    },
    "appProvides": {
      "type": "object",
      "required": ["entrypoints", "platforms", "capabilities"],
      "properties": {
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "description": "The command name (the shim registers under this)." },
              "path": { "$ref": "#/$defs/absPath" },
              "args_default": { "type": "array", "items": { "type": "string" } },
              "runtime_requirement": { "$ref": "#/$defs/runtimeRequirement" }
            }
          }
        },
        "platforms": { "$ref": "#/$defs/platformsAxis" },
        "capabilities": { "$ref": "#/$defs/capabilitiesApp" }
      }
    },
    "engineProvides": {
      "type": "object",
      "required": ["engine", "version", "abi_line", "platform"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "abi_line": { "type": "string", "minLength": 1 },
        "platform": { "$ref": "#/$defs/platformTriplet" },
        "implementation": { "type": "string", "minLength": 1, "description": "The engine implementation this build is (spec 28 §8 — mri / jruby / truffleruby); the spawn edge's implementation filter. Additive; absent = single-implementation engine or a pre-field manifest." }
      }
    },
    "runtimeProvides": {
      "type": "object",
      "required": ["provides", "built_from", "capabilities"],
      "properties": {
        "provides": {
          "description": "One-or-many: a single mapping (the spec's N=1 form) or a list — one entry per platform the image covers.",
          "anyOf": [
            { "$ref": "#/$defs/engineProvides" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/engineProvides" } }
          ]
        },
        "built_from": {
          "type": "object",
          "required": ["src_sha256", "patch_set"],
          "properties": {
            "src_sha256": { "$ref": "#/$defs/sha256hex" },
            "patch_set": { "type": "string", "minLength": 1 }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "description": "The spawn surface (spec 30 §2): commands this runtime boots as a separate process for a consumer payload's runtime-edge expose list. The app-entrypoint grammar minus runtime_requirement (a runtime runs on itself).",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "description": "The command name a consumer's expose list names." },
              "path": { "$ref": "#/$defs/absPath" },
              "args_default": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilitiesRuntime" }
      }
    },
    "dataProvides": {
      "type": "object",
      "required": ["mount_semantics", "capabilities"],
      "properties": {
        "mount_semantics": {
          "type": "object",
          "required": ["suggested"],
          "properties": {
            "suggested": { "$ref": "#/$defs/absPath" }
          },
          "description": "SUGGESTED only — the MOUNT RULE gives the mount decision to the consumer's manifest."
        },
        "consumers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": { "$ref": "#/$defs/capabilitiesData" }
      }
    },
    "requirement": {
      "description": "One dependency edge, discriminated by `kind`. The MOUNT RULE (locked): `mount` is declared by the CONSUMER's manifest — the provider never dictates its mount location.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "engine", "constraint"],
          "properties": {
            "kind": { "const": "language" },
            "engine": { "type": "string", "minLength": 1 },
            "constraint": { "$ref": "#/$defs/constraint" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "constraint"],
          "properties": {
            "kind": { "const": "toolkit" },
            "name": { "type": "string", "minLength": 1 },
            "constraint": { "$ref": "#/$defs/constraint" },
            "triplets": { "$ref": "#/$defs/platformList" },
            "mount": { "$ref": "#/$defs/absPath" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "constraint"],
          "properties": {
            "kind": { "const": "data" },
            "name": { "type": "string", "minLength": 1 },
            "constraint": { "$ref": "#/$defs/constraint" },
            "mount": { "$ref": "#/$defs/absPath" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "engine", "constraint"],
          "properties": {
            "kind": { "const": "runtime" },
            "engine": { "type": "string", "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 },
            "constraint": { "$ref": "#/$defs/constraint" },
            "expose": {
              "type": "array",
              "description": "spec 30 §1/§3 (schema_minor 4): the depended runtime's entries this payload surfaces — bare command names (no path separator, no drive qualifier), never repeated. The depended runtime resolves through the runtime index and is NEVER co-mounted (no mount key exists on this edge).",
              "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\:]+$" },
              "uniqueItems": true
            }
          }
        }
      ]
    }
  }
}
