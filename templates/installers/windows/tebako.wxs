<?xml version="1.0" encoding="utf-8"?>
<!--
  tebako.wxs — WiX v4/v5 source for the system MSI installer (roadmap 83,
  spec 16 §7). ONE template serves both identities: the tamatebako release
  pipeline binds its own values (Case A); a client (packed-mn class) binds
  its own product name / manufacturer / upgrade code against the same file
  (Case B — no fork, spec 00 invariant 10: the template is the SSOT).

  Required -d binds (all five — a missing bind fails the wix build loudly):
    ProductName     e.g. tebako                      (MSI ProductName; also the Program Files dir name)
    ProductVersion  MSI-safe major.minor.patch       (semver 3-part; MSI ignores a 4th field)
    Manufacturer    e.g. tamatebako                  (registry key root: HKLM\Software\<Manufacturer>\<ProductName>)
    UpgradeCode     a GUID, LOCKED FOREVER per product line (MajorUpgrade pairs on it;
                    a client MUST mint its own — reusing tebako's makes the two
                    products upgrade-collide on the same machine)
    BinDir          directory holding the exes to install (ALL *.exe land in
                    <root>\bin — curated by the caller's staging, spec 34 §7.3's
                    enumeration-by-extension applies to what the caller stages)

  Optional bind (the spec 16 §7 "Web bootstrapper" row):
    Bootstrap       any non-empty value (the build script passes 1 when
                    BOOTSTRAP_REGISTRY is set). The package then also:
                    (1) authors <root>\home\shims\ — the spec 05 §3.1
                    store-grammar marker that seats the bundle-sibling home
                    tier for the machine-scope store;
                    (2) installs <root>\bootstrap-seed.cmd (composed by
                    ci/windows-msi-build.sh: the client's add-registry +
                    install line set, self-locating, user-re-runnable);
                    (3) runs it ONCE — deferred, SYSTEM-scope,
                    failure-IGNORED (an offline machine's failed seed never
                    rolls back the tools install), console-hidden
                    (WixQuietExec64; output lands in the msi log);
                    (4) appends <root>\home\shims to the system PATH (the
                    seeded commands land there).
                    Absent/empty: byte-identical tool-only container.

  Layout installed (per-machine):
    %ProgramFiles%\<ProductName>\bin\*.exe
    %ProgramFiles%\<ProductName>\bootstrap-seed.cmd   (Bootstrap bound only)
    %ProgramFiles%\<ProductName>\home\shims\          (Bootstrap bound only)
    PATH (system, part=last) gains <root>\bin (and <root>\home\shims when
    Bootstrap is bound)
    HKLM\Software\<Manufacturer>\<ProductName> InstallDir = <root>

  Per-user data stays per-user: the store is ~/.tebako (TEBAKO_HOME honored);
  the MSI installs NO user-scope state and needs none.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first, or install the newer build over this one." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The install tree the components below reference (the v5 idiom:
         StandardDirectory, not a hand-nested TARGETDIR chain). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
        <Directory Id="BINFOLDER" Name="bin" />
<?if $(var.Bootstrap) != "" ?>
        <Directory Id="HOMEFOLDER" Name="home">
          <Directory Id="HOMESHIMSFOLDER" Name="shims" />
        </Directory>
<?endif?>
      </Directory>
    </StandardDirectory>

    <!-- Every staged exe lands in bin (the caller curates WHAT is staged —
         spec 34 §7.3). $(var.BinDir) arrives ABSOLUTE from the build
         script: WiX resolves relative authoring paths against this file's
         directory, never the caller's cwd. -->
    <ComponentGroup Id="BinFiles" Directory="BINFOLDER">
      <Files Include="$(var.BinDir)\*.exe" />
    </ComponentGroup>

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="BinFiles" />
      <ComponentRef Id="PathEnvironment" />
<?if $(var.Bootstrap) != "" ?>
      <ComponentRef Id="BundleHome" />
<?endif?>
    </Feature>

    <!-- PATH append, system scope, non-permanent (uninstall removes it).
         The RegistryValue is the component KeyPath: an Environment row
         alone leaves the component without a key path (ICE38). -->
    <Component Id="PathEnvironment" Directory="BINFOLDER">
      <Environment Id="TebakoPathEnvironment"
                   Name="PATH"
                   Action="set"
                   Part="last"
                   System="yes"
                   Permanent="no"
                   Value="[BINFOLDER]" />
      <RegistryValue Root="HKLM"
                     Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                     Name="InstallDir"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>

<?if $(var.Bootstrap) != "" ?>
    <!-- The web-bootstrapper payload (spec 16 §7): the seed script at the
         install root + the home\shims grammar marker (spec 05 §3.1) + the
         shims dir on PATH. -->
    <Component Id="BundleHome" Directory="INSTALLFOLDER">
      <File Source="$(var.BinDir)\bootstrap-seed.cmd" />
      <CreateFolder Directory="HOMESHIMSFOLDER" />
      <Environment Id="BundleShimsPath"
                   Name="PATH"
                   Action="set"
                   Part="last"
                   System="yes"
                   Permanent="no"
                   Value="[HOMESHIMSFOLDER]" />
      <RegistryValue Root="HKLM"
                     Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                     Name="BundleHome"
                     Type="string"
                     Value="[HOMEFOLDER]"
                     KeyPath="yes" />
    </Component>

    <!-- The seed: ONE deferred custom action, SYSTEM (writes the
         machine-scope home), Return=ignore (a failed seed never rolls
         back the tools install — the user re-runs bootstrap-seed.cmd
         later), WixQuietExec64 (no console flash). Requires the Util
         extension (ci/windows-msi-build.sh adds it when
         BOOTSTRAP_REGISTRY is set); WiX v5 names the extension's CA
         binary Wix4UtilCA_X64 (x64 package). -->
    <CustomAction Id="BootstrapSeed.SetProperty"
                  Property="BootstrapSeed"
                  Value='"[INSTALLFOLDER]bootstrap-seed.cmd"'
                  Execute="immediate" />
    <CustomAction Id="BootstrapSeed"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="BootstrapSeed.SetProperty" Before="BootstrapSeed" />
      <Custom Action="BootstrapSeed" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>
<?endif?>
  </Package>
</Wix>
