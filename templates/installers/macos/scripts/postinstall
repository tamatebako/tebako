#!/bin/bash
# postinstall — put the installed bin dir on PATH via /etc/paths.d
# (SIP-safe, MDM-friendly, picked up by path_helper for every NEW login
# shell). Tokens rendered by ci/macos-pkg-build.sh:
#   @INSTALL_ROOT@   e.g. /opt/tebako
#   @PRODUCT_NAME@   e.g. tebako
# Per-user state (the ~/.tebako store, the shims dir) is created by the
# CLI itself at first use — the pkg installs NO per-user files.
#
# Optional web-bootstrapper seed (spec 16 §7's "Web bootstrapper" row):
# ci/macos-pkg-build.sh splices the composed seed hook in place of the
# BOOTSTRAP_HOOK placeholder below when BOOTSTRAP_REGISTRY is bound —
# the add-registry + install line set, run DETACHED (PackageKit kills
# postinstall scripts that overrun its budget, so the network prefetch
# runs in the background, logged to @INSTALL_ROOT@/home/seed.log) into
# the machine-scope home (@INSTALL_ROOT@/home, grammar-marked so spec 05
# §3.1's bundle-sibling tier resolves it zero-config). The seed never
# inherits a cwd — PackageKit's sandbox cwd is torn down at install
# completion, and a getcwd() against it fails. Unbound: the placeholder
# line is deleted outright.
set -e
printf '%s\n' "@INSTALL_ROOT@/bin" > "/etc/paths.d/@PRODUCT_NAME@"
chmod 644 "/etc/paths.d/@PRODUCT_NAME@"
@BOOTSTRAP_HOOK@
